---
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import '../../styles/global.css';
import { getLangFromUrl, useTranslations, getLocalizedPath } from '../../i18n/utils';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  isHome?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description = t('layout.defaultDescription'), ogImage, noindex = false, isHome = false } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
const ogImageUrl = ogImage ?? `${Astro.site}${base}og-image.png`.replace(/\/\//g, '/').replace('https:/', 'https://');
const siteURL = new URL(base, Astro.site);
const websiteId = `${siteURL.href}#website`;

const structuredData = noindex ? undefined : {
  '@context': 'https://schema.org',
  '@graph': [
    ...(isHome ? [{
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteURL.href,
      name: 'FOSS Alternatives',
      description: t('layout.defaultDescription'),
      inLanguage: ['de', 'en'],
    }] : []),
    {
      '@type': 'WebPage',
      '@id': `${canonicalURL.href}#webpage`,
      url: canonicalURL.href,
      name: title,
      description,
      inLanguage: lang,
      isPartOf: { '@id': websiteId },
    },
  ],
};
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;

const deUrl = new URL(getLocalizedPath(Astro.url, 'de'), Astro.site);
const enUrl = new URL(getLocalizedPath(Astro.url, 'en'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <link rel="apple-touch-icon" href={`${base}icon.png`} />
    <link rel="sitemap" href={`${base}sitemap-index.xml`} />
    <link rel="alternate" type="application/rss+xml" title="FOSS Alternatives RSS" href={`${base}rss.xml`} />

    <!-- hreflang tags for SEO -->
    <link rel="alternate" hreflang="de" href={deUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={deUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="720" />
    <meta property="og:image:height" content="420" />
    <meta property="og:image:alt" content="FOSS Alternatives" />
    <meta property="og:site_name" content="FOSS Alternatives" />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {serializedStructuredData && (
      <script type="application/ld+json" set:html={serializedStructuredData} is:inline />
    )}

    <title>{title}</title>

    <!-- Theme initialization (prevent flash) -->
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme') || 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="skip-link">{t('layout.skipToContent')}</a>
    <Navigation />
    <main id="main-content" class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />

    <!-- Scroll-to-Top Button -->
    <button
      id="scroll-to-top"
      class="fixed bottom-6 right-6 z-50 hidden w-10 h-10 rounded-full bg-gray-800 hover:bg-gray-700 text-white shadow-lg transition-all duration-300 items-center justify-center"
      aria-label={t('layout.backToTop')}
      title={t('layout.backToTop')}
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 15l7-7 7 7" />
      </svg>
    </button>
    <script is:inline>
      (function() {
        var btn = document.getElementById('scroll-to-top');
        if (!btn) return;
        window.addEventListener('scroll', function() {
          if (window.scrollY > 300) {
            btn.style.display = 'flex';
          } else {
            btn.style.display = 'none';
          }
        });
        btn.addEventListener('click', function() {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>
  </body>
</html>
