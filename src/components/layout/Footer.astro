---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const footerLinks = [
  { href: `${base}${t('footer.href.categories')}`, label: t('footer.categories') },
  { href: `${base}${t('footer.href.tools')}`, label: t('footer.allTools') },
  { href: `${base}${t('footer.href.comparison')}`, label: t('footer.comparison') },
  { href: `${base}${t('footer.href.selfHost')}`, label: t('footer.selfHost') },
  { href: `${base}${t('footer.href.licenseOverview')}`, label: t('footer.licenseOverview') },
  { href: `${base}${t('footer.href.contribute')}`, label: t('footer.contribute') },
  { href: `${base}${t('footer.href.about')}`, label: t('footer.aboutUs') },
  { href: `${base}${t('footer.href.imprint')}`, label: t('footer.imprint') },
  { href: `${base}${t('footer.href.privacy')}`, label: t('footer.privacy') },
];
---

<footer
  class="mt-12"
  style="background: var(--color-bg-secondary); border-top: 1px solid var(--color-border)"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <a href={base} class="flex items-center gap-2 no-underline hover:no-underline shrink-0" aria-label={t('nav.home')}>
        <img
          src={`${base}icon.png`}
          alt=""
          width="24"
          height="24"
          class="w-6 h-6 rounded-md"
          decoding="async"
        />
        <span class="font-semibold text-sm" style="color: var(--color-text-primary)">
          FOSS <span class="gradient-text">Alternatives</span>
        </span>
      </a>

      <nav class="flex flex-wrap gap-x-4 gap-y-1 text-xs md:text-sm" aria-label={t('footer.navigation')}>
        {footerLinks.map(link => (
          <a
            href={link.href}
            class="no-underline hover:no-underline hover:text-red-400 transition-colors"
            style="color: var(--color-text-secondary)"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <a
        href="https://github.com/BEKO2210/european-alternatives.eu-free-open-source"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs no-underline hover:no-underline hover:text-red-400 transition-colors shrink-0"
        style="color: var(--color-text-muted)"
        aria-label={t('footer.viewOnGithub')}
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>

    <div class="mt-4 pt-3 flex flex-wrap items-center justify-center gap-x-2 gap-y-1 text-[11px]" style="border-top: 1px solid var(--color-border); color: var(--color-text-muted)">
      <span>© {year} FOSS Alternatives</span>
      <span aria-hidden="true">·</span>
      <span>{t('footer.license')}</span>
    </div>
  </div>
</footer>
