---
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const isEnglish = lang === 'en';
const targetLang = isEnglish ? 'de' : 'en';
const targetPath = getLocalizedPath(Astro.url, targetLang);
---

<div class="lang-toggle-wrapper" data-target-path={targetPath}>
  <span class:list={['lang-toggle-label', !isEnglish && 'lang-toggle-label--active']}>DE</span>
  <label class="lang-toggle">
    <input type="checkbox" checked={isEnglish} aria-label={isEnglish ? 'Switch to German' : 'Auf Englisch wechseln'} />
    <span class="lang-toggle__slider"></span>
  </label>
  <span class:list={['lang-toggle-label', isEnglish && 'lang-toggle-label--active']}>EN</span>
</div>

<style>
  .lang-toggle-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lang-toggle-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    transition: color 0.3s ease;
    user-select: none;
    line-height: 1;
  }

  .lang-toggle-label--active {
    color: var(--color-text-primary);
  }

  .lang-toggle {
    position: relative;
    display: inline-block;
    width: 2.5rem;
    height: 1.375rem;
    flex-shrink: 0;
  }

  .lang-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
    position: absolute;
  }

  .lang-toggle__slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--color-bg-tertiary);
    border: 1px solid var(--color-border);
    transition: background-color 0.3s ease, border-color 0.3s ease;
    border-radius: 1rem;
  }

  .lang-toggle__slider::before {
    position: absolute;
    content: '';
    height: 0.9375rem;
    width: 0.9375rem;
    border-radius: 50%;
    left: 0.15625rem;
    bottom: 0.15625rem;
    background-color: var(--color-text-secondary);
    transition: transform 0.3s ease, background-color 0.3s ease;
  }

  .lang-toggle input:checked + .lang-toggle__slider {
    background-color: var(--color-primary-glow);
    border-color: var(--color-border-accent);
  }

  .lang-toggle input:checked + .lang-toggle__slider::before {
    transform: translateX(1.125rem);
    background-color: var(--color-primary);
  }

  .lang-toggle input:focus-visible + .lang-toggle__slider {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }
</style>

<script>
  document.querySelectorAll('.lang-toggle-wrapper').forEach(wrapper => {
    const input = wrapper.querySelector('input');
    const targetPath = (wrapper as HTMLElement).dataset.targetPath;
    if (input && targetPath) {
      input.addEventListener('change', () => {
        window.location.href = targetPath;
      });
    }
  });
</script>
